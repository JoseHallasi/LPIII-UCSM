// Archivo "MarcoBorderLayout.java"
// Demostración de BorderLayout: al pulsar un botón se oculta y los demás ocupan su espacio.
import java.awt.BorderLayout;
import java.awt.event.ActionEvent;
import java.awt.event.ActionListener;
import javax.swing.JButton;
import javax.swing.JFrame;

public class MarcoBorderLayout extends JFrame implements ActionListener
{
    private final JButton[] botones; // un botón por región
    private static final String[] NOMBRES =
        {"Ocultar Norte", "Ocultar Sur", "Ocultar Este", "Ocultar Oeste", "Ocultar Centro"};
    private static final String[] REGIONES = {BorderLayout.NORTH, BorderLayout.SOUTH,
        BorderLayout.EAST, BorderLayout.WEST, BorderLayout.CENTER};
    private final BorderLayout esquema;

    public MarcoBorderLayout()
    {
        super("BorderLayout - " + Integrantes.NOMBRES);
        esquema = new BorderLayout(5, 5); // 5 píxeles de separación horizontal y vertical
        setLayout(esquema);

        botones = new JButton[NOMBRES.length];
        for (int i = 0; i < NOMBRES.length; i++)
        {
            botones[i] = new JButton(NOMBRES[i]);
            botones[i].addActionListener(this);
            add(botones[i], REGIONES[i]); // agrega cada botón a su región
        }
    }

    // oculta el botón pulsado y muestra los demás
    @Override
    public void actionPerformed(ActionEvent evento)
    {
        for (JButton boton : botones)
            boton.setVisible(evento.getSource() != boton);
        esquema.layoutContainer(getContentPane()); // redistribuye el contenido
    }
} // fin de la clase MarcoBorderLayout


3. GridLayout
GridLayout ordena los componentes en una cuadrícula de filas y columnas donde todas las celdas tienen el mismo tamaño. Cada clic en cualquier botón alterna entre una cuadrícula de 2x3 con separación de 5 píxeles y otra de 3x2 sin separación.

Java — Código Fuente
// Archivo "MarcoGridLayout.java"
// Demostración de GridLayout: cada clic alterna entre una cuadrícula de 2x3 y otra de 3x2.
import java.awt.Container;
import java.awt.GridLayout;
import java.awt.event.ActionEvent;
import java.awt.event.ActionListener;
import javax.swing.JButton;
import javax.swing.JFrame;

public class MarcoGridLayout extends JFrame implements ActionListener
{
    private final JButton[] botones;
    private static final String[] NOMBRES = {"uno", "dos", "tres", "cuatro", "cinco", "seis"};
    private boolean alternar = true;        // indica qué esquema se muestra
    private final Container contenedor;
    private final GridLayout cuadricula1;   // 2 filas, 3 columnas
    private final GridLayout cuadricula2;   // 3 filas, 2 columnas

    public MarcoGridLayout()
    {
        super("GridLayout - " + Integrantes.NOMBRES);
        cuadricula1 = new GridLayout(2, 3, 5, 5); // con 5 píxeles de separación
        cuadricula2 = new GridLayout(3, 2);       // sin separación
        contenedor = getContentPane();
        setLayout(cuadricula1);

        botones = new JButton[NOMBRES.length];
        for (int i = 0; i < NOMBRES.length; i++)
        {
            botones[i] = new JButton(NOMBRES[i]);
            botones[i].addActionListener(this);
            add(botones[i]);
        }
    }

    // alterna entre los dos esquemas de cuadrícula
    @Override
    public void actionPerformed(ActionEvent evento)
    {
        contenedor.setLayout(alternar ? cuadricula2 : cuadricula1);
        alternar = !alternar;
        contenedor.validate(); // vuelve a distribuir los componentes
    }
} // fin de la clase MarcoGridLayout

