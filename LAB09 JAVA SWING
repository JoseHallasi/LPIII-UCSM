// Archivo "MarcoFlowLayout.java"
import java.awt.Container;
import java.awt.FlowLayout;
import javax.swing.JButton;
import javax.swing.JFrame;

public class MarcoFlowLayout extends JFrame
{
    private final JButton botonIzquierda; // alinea a la izquierda
    private final JButton botonCentro;    // alinea al centro
    private final JButton botonDerecha;   // alinea a la derecha
    private final FlowLayout esquema;     // objeto del esquema
    private final Container contenedor;   // contenedor donde se aplica el esquema

    public MarcoFlowLayout()
    {
        super("FlowLayout - " + Integrantes.NOMBRES);
        esquema = new FlowLayout();
        contenedor = getContentPane();
        setLayout(esquema);

        botonIzquierda = new JButton("Izquierda");
        add(botonIzquierda);
        botonIzquierda.addActionListener(e -> cambiarAlineacion(FlowLayout.LEFT));

        botonCentro = new JButton("Centro");
        add(botonCentro);
        botonCentro.addActionListener(e -> cambiarAlineacion(FlowLayout.CENTER));

        botonDerecha = new JButton("Derecha");
        add(botonDerecha);
        botonDerecha.addActionListener(e -> cambiarAlineacion(FlowLayout.RIGHT));

        // botones extra para ver cómo FlowLayout pasa a la siguiente fila
        for (int i = 1; i <= 4; i++)
            add(new JButton("Componente " + i));
    }

    // cambia la alineación y vuelve a distribuir los componentes
    private void cambiarAlineacion(int alineacion)
    {
        esquema.setAlignment(alineacion);
        esquema.layoutContainer(contenedor);
    }
} // fin de la clase MarcoFlowLayout


2. BorderLayout
BorderLayout divide el contenedor en cinco regiones (NORTH, SOUTH, EAST, WEST y CENTER) y admite un solo componente por región. Al pulsar un botón, este se oculta y las regiones vecinas ocupan su espacio.


