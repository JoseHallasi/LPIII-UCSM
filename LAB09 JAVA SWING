package Ejercicio2;

import java.awt.BorderLayout;
import java.awt.FlowLayout;
import java.awt.GridLayout;
import java.awt.event.ActionListener;
import java.awt.event.ActionEvent;
import javax.swing.BorderFactory;
import javax.swing.ButtonGroup;
import javax.swing.JButton;
import javax.swing.JCheckBox;
import javax.swing.JComboBox;
import javax.swing.JFrame;
import javax.swing.JLabel;
import javax.swing.JList;
import javax.swing.JOptionPane;
import javax.swing.JPanel;
import javax.swing.JRadioButton;
import javax.swing.JTextField;
import javax.swing.ListSelectionModel;

public class MarcoCompraPasaje extends JFrame
{
    private final JPanel panelDatos;
    private final JPanel panelPiso;
    private final JPanel panelServicios;
    private final JPanel panelBotones;

    private final JLabel etiquetaNombres;
    private final JLabel etiquetaDocumento;
    private final JLabel etiquetaFecha;
    private final JLabel etiquetaOrigen;
    private final JLabel etiquetaDestino;
    private final JLabel etiquetaPiso;
    private final JLabel etiquetaServicios;
    private final JLabel etiquetaCalidad;

    private final JTextField campoNombres;
    private final JTextField campoDocumento;
    private final JTextField campoFecha;

    private final JComboBox<String> comboOrigen;
    private final JComboBox<String> comboDestino;

    private final JRadioButton botonPrimerPiso;
    private final JRadioButton botonSegundoPiso;
    private final ButtonGroup grupoPisos;

    private final JCheckBox casillaAudifonos;
    private final JCheckBox casillaManta;
    private final JCheckBox casillaRevistas;

    private final JList<String> listaCalidad;

    private final JButton botonResumen;
    private final JButton botonReiniciar;

    private static final String[] LUGARES = { "-- Seleccione --", "Arequipa", "Lima", "Cusco",
        "Tacna", "Puno", "Ica", "Moquegua" };
    private static final String[] CALIDADES = { "Economico", "Standard", "VIP" };

    public MarcoCompraPasaje()
    {
        super("Compra de pasajes - Transporte terrestre");
        setLayout(new BorderLayout());

        panelDatos = new JPanel();
        panelDatos.setLayout(new GridLayout(0, 2, 10, 8));
        panelDatos.setBorder(BorderFactory.createEmptyBorder(10, 10, 10, 10));

        etiquetaNombres = new JLabel("Nombres completos:");
        campoNombres = new JTextField(20);
        campoNombres.setToolTipText("Escriba nombres y apellidos del pasajero");
        panelDatos.add(etiquetaNombres);
        panelDatos.add(campoNombres);

        etiquetaDocumento = new JLabel("Documento de identidad (DNI):");
        campoDocumento = new JTextField(8);
        campoDocumento.setToolTipText("8 digitos");
        panelDatos.add(etiquetaDocumento);
        panelDatos.add(campoDocumento);

        etiquetaFecha = new JLabel("Fecha de viaje (dd/mm/aaaa):");
        campoFecha = new JTextField(10);
        campoFecha.setToolTipText("Ejemplo: 25/12/2026");
        panelDatos.add(etiquetaFecha);
        panelDatos.add(campoFecha);

        etiquetaOrigen = new JLabel("Lugar de origen:");
        comboOrigen = new JComboBox<String>(LUGARES);
        panelDatos.add(etiquetaOrigen);
        panelDatos.add(comboOrigen);

        etiquetaDestino = new JLabel("Lugar de destino:");
        comboDestino = new JComboBox<String>(LUGARES);
        panelDatos.add(etiquetaDestino);
        panelDatos.add(comboDestino);

        etiquetaPiso = new JLabel("Piso:");
        panelPiso = new JPanel(new FlowLayout(FlowLayout.LEFT, 5, 0));
        botonPrimerPiso = new JRadioButton("1er piso", true);
        botonSegundoPiso = new JRadioButton("2do piso", false);
        grupoPisos = new ButtonGroup();
        grupoPisos.add(botonPrimerPiso);
        grupoPisos.add(botonSegundoPiso);
        panelPiso.add(botonPrimerPiso);
        panelPiso.add(botonSegundoPiso);
        panelDatos.add(etiquetaPiso);
        panelDatos.add(panelPiso);

        etiquetaServicios = new JLabel("Servicios opcionales:");
        panelServicios = new JPanel(new FlowLayout(FlowLayout.LEFT, 5, 0));
        casillaAudifonos = new JCheckBox("Audifonos");
        casillaManta = new JCheckBox("Manta");
        casillaRevistas = new JCheckBox("Revistas");
        panelServicios.add(casillaAudifonos);
        panelServicios.add(casillaManta);
        panelServicios.add(casillaRevistas);
        panelDatos.add(etiquetaServicios);
        panelDatos.add(panelServicios);

        etiquetaCalidad = new JLabel("Calidad de servicio:");
        listaCalidad = new JList<String>(CALIDADES);
        listaCalidad.setVisibleRowCount(3);
        listaCalidad.setSelectionMode(ListSelectionModel.SINGLE_SELECTION);
        listaCalidad.setBorder(BorderFactory.createLineBorder(java.awt.Color.GRAY));
        panelDatos.add(etiquetaCalidad);
        panelDatos.add(listaCalidad);

        add(panelDatos, BorderLayout.CENTER);

        panelBotones = new JPanel(new FlowLayout());
        botonResumen = new JButton("Mostrar resumen");
        botonReiniciar = new JButton("Reiniciar");
        panelBotones.add(botonResumen);
        panelBotones.add(botonReiniciar);
        add(panelBotones, BorderLayout.SOUTH);

        ManejadorBotones manejador = new ManejadorBotones();
        botonResumen.addActionListener(manejador);
        botonReiniciar.addActionListener(manejador);
    }

    private String validarDatos()
    {
        if (campoNombres.getText().trim().isEmpty())
            return "Debe ingresar los nombres del pasajero.";

        if (!campoDocumento.getText().trim().matches("\\d{8}"))
            return "El documento de identidad debe tener 8 digitos numericos.";

        if (!campoFecha.getText().trim().matches("\\d{2}/\\d{2}/\\d{4}"))
            return "La fecha de viaje debe tener el formato dd/mm/aaaa.";

        if (comboOrigen.getSelectedIndex() == 0)
            return "Debe seleccionar un lugar de origen.";

        if (comboDestino.getSelectedIndex() == 0)
            return "Debe seleccionar un lugar de destino.";

        if (comboOrigen.getSelectedIndex() == comboDestino.getSelectedIndex())
            return "El origen y el destino no pueden ser iguales.";

        if (listaCalidad.isSelectionEmpty())
            return "Debe elegir una calidad de servicio.";

        return "";
    }

    private void mostrarResumen()
    {
        String error = validarDatos();

        if (!error.isEmpty())
        {
            JOptionPane.showMessageDialog(this, error, "Datos incompletos",
                JOptionPane.WARNING_MESSAGE);
            return;
        }

        String servicios = "";
        if (casillaAudifonos.isSelected())
            servicios += "Audifonos, ";
        if (casillaManta.isSelected())
            servicios += "Manta, ";
        if (casillaRevistas.isSelected())
            servicios += "Revistas, ";

        if (servicios.isEmpty())
            servicios = "Ninguno";
        else
            servicios = servicios.substring(0, servicios.length() - 2);

        String piso = botonPrimerPiso.isSelected() ? "1er piso" : "2do piso";

        String resumen = String.format(
            "RESUMEN DE LA COMPRA%n%n" +
            "Pasajero: %s%n" +
            "Documento: %s%n" +
            "Fecha de viaje: %s%n" +
            "Origen: %s%n" +
            "Destino: %s%n" +
            "Piso: %s%n" +
            "Servicios opcionales: %s%n" +
            "Calidad de servicio: %s",
            campoNombres.getText().trim(),
            campoDocumento.getText().trim(),
            campoFecha.getText().trim(),
            comboOrigen.getSelectedItem(),
            comboDestino.getSelectedItem(),
            piso,
            servicios,
            listaCalidad.getSelectedValue());

        JOptionPane.showMessageDialog(this, resumen, "Resumen del pasaje",
            JOptionPane.INFORMATION_MESSAGE);
    }

    private void reiniciarFormulario()
    {
        campoNombres.setText("");
        campoDocumento.setText("");
        campoFecha.setText("");
        comboOrigen.setSelectedIndex(0);
        comboDestino.setSelectedIndex(0);
        botonPrimerPiso.setSelected(true);
        casillaAudifonos.setSelected(false);
        casillaManta.setSelected(false);
        casillaRevistas.setSelected(false);
        listaCalidad.clearSelection();
        campoNombres.requestFocus();
    }

    private class ManejadorBotones implements ActionListener
    {
        @Override
        public void actionPerformed(ActionEvent evento)
        {
            if (evento.getSource() == botonResumen)
                mostrarResumen();
            else if (evento.getSource() == botonReiniciar)
                reiniciarFormulario();
        }
    }
}


