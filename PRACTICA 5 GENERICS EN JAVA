public class IgualGenerico {
 
    public static <T> boolean esIgualA(T a, T b) {
        return a.equals(b);
    }
 
    public static void main(String[] args) {
        Object o = new Object();
 
        System.out.println("int: " + esIgualA(5, 5));
        System.out.println("double: " + esIgualA(2.5, 3.5));
        System.out.println("char: " + esIgualA('a', 'a'));
        System.out.println("Integer: " + esIgualA(Integer.valueOf(10), Integer.valueOf(10)));
        System.out.println("String: " + esIgualA("hola", "hola"));
        System.out.println("Object: " + esIgualA(o, o));
        System.out.println("Object distintos: " + esIgualA(new Object(), new Object()));
        System.out.println("null: " + esIgualA(null, null));
    }
}
