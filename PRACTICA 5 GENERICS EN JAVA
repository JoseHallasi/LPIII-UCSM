package Ejercicio2;

public class Par<F, S> {

    private F primero;
    private S segundo;

    public Par(F primero, S segundo) {
        this.primero = primero;
        this.segundo = segundo;
    }

    // Devuelve F: quien llama recibe el tipo exacto y no necesita hacer casting.
    public F getPrimero() {
        return primero;
    }

    // Devuelve S por la misma razon: el tipo del segundo elemento se conserva.
    public S getSegundo() {
        return segundo;
    }

    // Solo acepta un valor de tipo F. Si se intenta guardar otro tipo,
    // el error aparece al compilar y no al ejecutar el programa.
    public void setPrimero(F primero) {
        this.primero = primero;
    }

    // Solo acepta un valor de tipo S.
    public void setSegundo(S segundo) {
        this.segundo = segundo;
    }

    // El parametro es Par<F, S>, es decir, el otro par debe tener los mismos tipos
    // que este. Comparar un Par<String, Integer> con un Par<Double, Boolean> ni
    // siquiera compila, porque nunca podrian ser iguales.
    public boolean esIgual(Par<F, S> otro) {
        // Un par nunca es igual a una referencia nula
        if (otro == null) {
            return false;
        }
        // Son iguales solo si coinciden los dos valores y en el mismo orden
        return sonIguales(this.primero, otro.primero)
                && sonIguales(this.segundo, otro.segundo);
    }

    // Metodo auxiliar que compara dos valores con equals.
    // Se usa equals y no "==" porque "==" compara referencias y equals compara el contenido.
    // Se revisa null antes para evitar un NullPointerException al llamar a equals.
    private boolean sonIguales(Object a, Object b) {
        if (a == null) {
            return b == null;
        }
        return a.equals(b);
    }

    @Override
    public String toString() {
        return "(Primero: " + primero + ", Segundo: " + segundo + ")";
    }
}

