        Pila<Integer> p1 = new Pila<>(5);
        Pila<Integer> p2 = new Pila<>(5);
        Pila<Integer> p3 = new Pila<>(5);
 
        for (int i = 1; i <= 3; i++) {
            p1.push(i);
            p2.push(i);
        }
        p3.push(3);
        p3.push(2);
        p3.push(1);
 
        System.out.println("p1 contiene 2: " + p1.contains(2));
        System.out.println("p1 contiene 9: " + p1.contains(9));
        System.out.println("p1 igual a p2: " + p1.esIgual(p2));
        System.out.println("p1 igual a p3: " + p1.esIgual(p3));
 
