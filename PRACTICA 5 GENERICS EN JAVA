package Ejercicio4;

import java.util.ArrayList;

public class PruebaContenedor {

    public static void main(String[] args) {

        // Al indicar <String, Integer> el compilador exige esos tipos en agregarPar.
        Contenedor<String, Integer> notas = new Contenedor<>();

        // Prueba con el contenedor vacio
        System.out.println("Contenedor vacio:");
        notas.mostrarPares();

        // agregarPar: los enteros 18, 15 y 20 pasan por autoboxing a Integer
        notas.agregarPar("Renato", 18);
        notas.agregarPar("Daniel", 15);
        notas.agregarPar("Camila", 20);

        System.out.println();
        System.out.println("Contenedor con tres pares:");
        notas.mostrarPares();

        // obtenerPar: el resultado es un Par<String, Integer>, por eso los getters
        // devuelven String e Integer directamente, sin casting
        Par<String, Integer> segundoPar = notas.obtenerPar(1);
        String nombre = segundoPar.getPrimero();
        Integer nota = segundoPar.getSegundo();
        System.out.println();
        System.out.println("Par en la posicion 1: " + segundoPar);
        System.out.println("Nombre: " + nombre + ", nota: " + nota);

        // obtenerTodosLosPares: devuelve una copia de la lista
        ArrayList<Par<String, Integer>> copia = notas.obtenerTodosLosPares();
        System.out.println();
        System.out.println("Cantidad de pares obtenidos: " + copia.size());

        // Se borra la copia para comprobar que el contenedor original no cambia
        copia.clear();
        System.out.println("Pares en la copia despues de limpiarla: " + copia.size());
        System.out.println("Pares que sigue guardando el contenedor:");
        notas.mostrarPares();

        // Indice fuera de rango: se captura la excepcion que lanza ArrayList
        System.out.println();
        try {
            notas.obtenerPar(10);
        } catch (IndexOutOfBoundsException e) {
            System.out.println("Error al obtener el par 10: " + e.getMessage());
        }

        // Los mismos tipos genericos permiten otra combinacion sin cambiar la clase
        Contenedor<Double, Boolean> mediciones = new Contenedor<>();
        mediciones.agregarPar(3.5, true);
        mediciones.agregarPar(7.2, false);
        System.out.println();
        System.out.println("Contenedor de Double y Boolean:");
        mediciones.mostrarPares();
    }
}


