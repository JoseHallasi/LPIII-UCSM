        Par<Double, Boolean> parMedicion = new Par<>(3.5, true);
        System.out.println("Par de medicion: " + parMedicion);

        // Los getters devuelven el tipo exacto, por eso se asigna a String e Integer
        // sin casting.
        String nombre = parAlumno.getPrimero();
        Integer edad = parAlumno.getSegundo();
        System.out.println("Nombre leido: " + nombre + ", edad leida: " + edad);

        // Los setters modifican cada elemento respetando su tipo.
        parAlumno.setPrimero("Daniel");
        parAlumno.setSegundo(21);
        System.out.println("Par de alumno modificado: " + parAlumno);

        System.out.println();
        System.out.println("Pruebas del metodo esIgual");

        Par<String, Integer> parA = new Par<>("Renato", 20);

        // Mismos valores en el mismo orden: debe dar true.
        Par<String, Integer> parB = new Par<>("Renato", 20);
        System.out.println("Mismos valores: " + parA.esIgual(parB));

        // new String crea otro objeto en memoria con el mismo texto. Aun asi da true
        // porque esIgual usa equals, que compara contenido y no referencias.
        Par<String, Integer> parC = new Par<>(new String("Renato"), 20);
        System.out.println("Mismo texto, distinto objeto: " + parA.esIgual(parC));

        // Cambia solo el primer elemento: debe dar false.
        Par<String, Integer> parD = new Par<>("Daniel", 20);
        System.out.println("Distinto primer elemento: " + parA.esIgual(parD));

        // Cambia solo el segundo elemento: debe dar false.
        Par<String, Integer> parE = new Par<>("Renato", 25);
        System.out.println("Distinto segundo elemento: " + parA.esIgual(parE));

        // Mismos valores en distinto orden: debe dar false, el orden importa.
        Par<Integer, Integer> parUnoDos = new Par<>(1, 2);
        Par<Integer, Integer> parDosUno = new Par<>(2, 1);
        System.out.println("Mismos valores, distinto orden: " + parUnoDos.esIgual(parDosUno));

        // Comparacion con null: debe dar false y no lanzar excepcion.
        System.out.println("Comparado con null: " + parA.esIgual(null));

        // Par con un elemento nulo: la comparacion tampoco lanza excepcion.
        Par<String, Integer> parConNulo1 = new Par<>(null, 5);
        Par<String, Integer> parConNulo2 = new Par<>(null, 5);
        System.out.println("Pares con elemento nulo: " + parConNulo1.esIgual(parConNulo2));

    }
}

