public class ExcepcionPilaLlena extends RuntimeException {
    public ExcepcionPilaLlena(String msg) {
        super(msg);
    }
}
public class ExcepcionPilaVacia extends RuntimeException {
    public ExcepcionPilaVacia(String msg) {
        super(msg);
    }
}
public class Pila<E> {
    private final int tamanio;
    private int superior;
    private E[] elementos;
 
    public Pila() {
        this(10);
    }
 
    @SuppressWarnings("unchecked")
    public Pila(int s) {
        tamanio = s > 0 ? s : 10;
        superior = -1;
        elementos = (E[]) new Object[tamanio];
    }
 
    public void push(E valor) {
        if (superior == tamanio - 1)
            throw new ExcepcionPilaLlena("La pila esta llena, no se puede meter " + valor);
        elementos[++superior] = valor;
    }
 
    public E pop() {
        if (superior == -1)
            throw new ExcepcionPilaVacia("Pila vacia, no se puede sacar");
        return elementos[superior--];
    }
 
    public boolean contains(E elemento) {
        for (int i = superior; i >= 0; i--)
            if (elementos[i].equals(elemento))
                return true;
        return false;
    }
 
}
