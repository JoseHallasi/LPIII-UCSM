package Ejercicio4;

import java.util.ArrayList;

public class Contenedor<F, S> {

    // un generico dentro de otro generico.
    // Los tipos F y S del contenedor pasan directamente al Par, por eso todos los
    // pares guardados tienen los mismos tipos. Se usa ArrayList y no un arreglo
    // porque crece solo y no hay que definir un tamano fijo.
    private ArrayList<Par<F, S>> pares;

    // El operador diamante <> deja que el compilador deduzca los tipos del ArrayList
    // a partir de la declaracion del atributo.
    public Contenedor() {
        pares = new ArrayList<>();
    }

    //el compilador verifica que primero sea de tipo F y segundo de tipo S.
    public void agregarPar(F primero, S segundo) {
        pares.add(new Par<>(primero, segundo));
    }

    // Devuelve el par de la posicion indicada. El retorno es Par<F, S>, por eso
    // quien lo recibe puede usar getPrimero y getSegundo sin casting.
    // Si el indice no existe, ArrayList lanza IndexOutOfBoundsException (no
    // verificada), y se deja que llegue a quien llama para que decida que hacer.
    public Par<F, S> obtenerPar(int indice) {
        return pares.get(indice);
    }

    // Devuelve una copia de la lista y no la lista interna. Asi, quien la recibe
    // puede modificarla sin alterar lo que guarda el contenedor
    public ArrayList<Par<F, S>> obtenerTodosLosPares() {
        return new ArrayList<>(pares);
    }

    // Imprime todos los pares numerados desde 1.println llama al toString de cada par.
    public void mostrarPares() {
        if (pares.isEmpty()) {
            System.out.println("El contenedor no tiene pares");
            return;
        }
        int numero = 1;
        for (Par<F, S> par : pares) {
            System.out.println(numero + ". " + par);
            numero++;
        }
    }
}
