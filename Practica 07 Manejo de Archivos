package Ejercicio4;

import java.io.*;
import java.util.ArrayList;
import java.util.HashMap;
import java.util.List;
import java.util.Map;
import java.util.Scanner;

public class ContadorPalabras {

    private static final int TOP_PALABRAS = 10;

    private int totalLineas;
    private int totalPalabras;
    private int totalCaracteres;
    private final Map<String, Integer> frecuencias = new HashMap<>();

    public static void main(String[] args) {
        ContadorPalabras contador = new ContadorPalabras();
        Scanner scanner = new Scanner(System.in);
        boolean terminado = false;

        while (!terminado) {
            File archivo = seleccionarArchivo(scanner);

            if (archivo == null) {
                System.out.print("¿Deseas intentar con otro archivo? (s/n): ");
                String respuesta = scanner.nextLine().trim();
                if (!respuesta.equalsIgnoreCase("s") && !respuesta.equalsIgnoreCase("si")) {
                    System.out.println("Programa finalizado sin analizar ningún archivo.");
                    break;
                }
                continue;
            }

            String error = validarArchivo(archivo);
            if (error != null) {
                notificarError(error);
                continue;
            }

            try {
                contador.analizar(archivo);
                contador.mostrarResultados(archivo);
                terminado = true;
            } catch (IOException e) {
                notificarError("Ocurrió un error al leer el archivo: " + e.getMessage());
            }
        }
        scanner.close();
    }

    private static File seleccionarArchivo(Scanner scanner) {
        System.out.print("\nIntroduce la ruta del archivo a analizar (o presiona Enter para salir): ");
        String ruta = scanner.nextLine().trim();
        if (ruta.isEmpty()) {
            return null;
        }
        return new File(ruta);
    }

    public static String validarArchivo(File archivo) {
        if (!archivo.exists()) {
            return "El archivo '" + archivo.getName() + "' no existe.";
        }
        if (!archivo.isFile()) {
            return "'" + archivo.getName() + "' no es un archivo (es un directorio).";
        }
        if (!archivo.canRead()) {
            return "No se tienen permisos para leer '" + archivo.getName() + "'.";
        }
        return null;
    }

    private static void notificarError(String mensaje) {
        System.out.println("[ERROR] " + mensaje + " Por favor, intenta de nuevo.");
    }

    public void analizar(File archivo) throws IOException {
        totalLineas = 0;
        totalPalabras = 0;
        totalCaracteres = 0;
        frecuencias.clear();

        try (BufferedReader lector = new BufferedReader(new FileReader(archivo))) {
            String linea;
            while ((linea = lector.readLine()) != null) {
                totalLineas++;
                totalCaracteres += linea.length();
                contarPalabras(linea);
            }
        }
    }

    private void contarPalabras(String linea) {
        StringBuilder palabra = new StringBuilder();

        for (int i = 0; i < linea.length(); i++) {
            char c = linea.charAt(i);
            if (Character.isLetterOrDigit(c)) {
                palabra.append(Character.toLowerCase(c));
            } else if (palabra.length() > 0) {
                registrarPalabra(palabra.toString());
                palabra.setLength(0);
            }
        }
        if (palabra.length() > 0) {
            registrarPalabra(palabra.toString());
        }
    }

    private void registrarPalabra(String palabra) {
        totalPalabras++;
        frecuencias.merge(palabra, 1, Integer::sum);
    }

    public double getPromedioPalabrasPorLinea() {
        if (totalLineas == 0) {
            return 0;
        }
        return (double) totalPalabras / totalLineas;
    }

    private List<Map.Entry<String, Integer>> palabrasMasFrecuentes() {
        List<Map.Entry<String, Integer>> lista = new ArrayList<>(frecuencias.entrySet());
        lista.sort((a, b) -> {
            int porFrecuencia = Integer.compare(b.getValue(), a.getValue());
            return (porFrecuencia != 0) ? porFrecuencia : a.getKey().compareTo(b.getKey());
        });
        return lista;
    }

    public void mostrarResultados(File archivo) {
        System.out.println("\n=== RESULTADOS PARA: " + archivo.getName() + " ===");
        System.out.println("Total de líneas:       " + totalLineas);
        System.out.println("Total de palabras:     " + totalPalabras);
        System.out.println("Total de caracteres:   " + totalCaracteres + " (sin contar fin de línea)");
        System.out.printf("Promedio de palabras por línea: %.2f%n", getPromedioPalabrasPorLinea());

        List<Map.Entry<String, Integer>> ranking = palabrasMasFrecuentes();
        if (ranking.isEmpty()) {
            System.out.println("\nEl archivo no contiene palabras.");
            return;
        }

        int cantidad = Math.min(TOP_PALABRAS, ranking.size());
        System.out.println("\nPalabras más frecuentes (top " + cantidad + "):");
        for (int i = 0; i < cantidad; i++) {
            Map.Entry<String, Integer> entrada = ranking.get(i);
            System.out.printf("%2d. %-15s %d%n", i + 1, entrada.getKey(), entrada.getValue());
        }
    }
}
