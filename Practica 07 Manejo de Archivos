package Ejercicio3;

import java.io.*;
import java.util.ArrayList;
import java.util.List;
 
public class ModeloEmpleados {
 
    private final String rutaArchivo;
 
    public ModeloEmpleados(String rutaArchivo) {
        this.rutaArchivo = rutaArchivo;
    }
 
    public List<Empleado> leerEmpleados() throws IOException {
        List<Empleado> empleados = new ArrayList<>();
 
        File archivo = new File(rutaArchivo);
        if (!archivo.exists()) {
            return empleados;
        }
 
        try (FileInputStream fis = new FileInputStream(archivo);
             DataInputStream entrada = new DataInputStream(fis)) {
 
            try {
                while (true) {
                    int numero = entrada.readInt();
                    String nombre = entrada.readUTF();
                    double sueldo = entrada.readDouble();
                    empleados.add(new Empleado(numero, nombre, sueldo));
                }
            } catch (EOFException e) {
            } catch (IllegalArgumentException e) {
                throw new IOException("El archivo contiene datos inválidos: " + e.getMessage());
            }
        }
        return empleados;
    }
 
    public boolean agregarEmpleado(Empleado nuevo) throws IOException {
        if (buscarEmpleado(nuevo.getNumero()) != null) {
            return false;
        }
 
        try (FileOutputStream fos = new FileOutputStream(rutaArchivo, true);
             DataOutputStream salida = new DataOutputStream(fos)) {
            escribirRegistro(salida, nuevo);
        }
        return true;
    }
 
    public Empleado buscarEmpleado(int numero) throws IOException {
        for (Empleado e : leerEmpleados()) {
            if (e.getNumero() == numero) {
                return e;
            }
        }
        return null;
    }
 
    public boolean eliminarEmpleado(int numero) throws IOException {
        List<Empleado> empleados = leerEmpleados();
 
        boolean eliminado = false;
        for (int i = 0; i < empleados.size(); i++) {
            if (empleados.get(i).getNumero() == numero) {
                empleados.remove(i);
                eliminado = true;
                break;
            }
        }
 
        if (eliminado) {
            guardarTodos(empleados);
        }
        return eliminado;
    }
 
    private void guardarTodos(List<Empleado> empleados) throws IOException {
        try (FileOutputStream fos = new FileOutputStream(rutaArchivo);
             DataOutputStream salida = new DataOutputStream(fos)) {
            for (Empleado e : empleados) {
                escribirRegistro(salida, e);
            }
        }
    }
 
    private void escribirRegistro(DataOutputStream salida, Empleado e) throws IOException {
        salida.writeInt(e.getNumero());
        salida.writeUTF(e.getNombre());
        salida.writeDouble(e.getSueldo());
    }
}


