package lab7;

import java.io.IOException;
import java.nio.file.DirectoryStream;
import java.nio.file.Files;
import java.nio.file.Path;
import java.nio.file.Paths;
import java.util.Scanner;

public class TestFile{

    public static void main(String[] args) throws IOException {
        try (Scanner scanner = new Scanner(System.in)) {
            System.out.println("Escriba el nombre del archivo o directorio:");
            String nombre = scanner.nextLine();

            Path ruta = Paths.get(nombre);

            if (Files.exists(ruta)) {
                System.out.println("El nombre es: " + ruta.getFileName());
                System.out.println("¿Es un archivo regular? " + (Files.isRegularFile(ruta) ? "Sí" : "No"));
                System.out.println("¿Es una ruta absoluta? " + (ruta.isAbsolute() ? "Sí" : "No"));
                System.out.println("Fecha de última modificación: " + Files.getLastModifiedTime(ruta));
                System.out.println("Tamaño: " + Files.size(ruta) + " bytes");
                System.out.println("Ruta absoluta: " + ruta.toAbsolutePath());

                if (Files.isDirectory(ruta)) {
                    System.out.println("Contenido del directorio:");

                    try (DirectoryStream<Path> contenido = Files.newDirectoryStream(ruta)) {
                        for (Path elemento : contenido) {
                            System.out.println(elemento.getFileName());
                        }
                    }
                }
            } else {
                System.out.println("No existe: " + ruta);
            }
        }
    }
}

