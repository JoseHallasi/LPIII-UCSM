package Ejercicio2;

public class Personaje {
	 
    public static final int BONUS_VIDA = 2;
    public static final int BONUS_ATAQUE = 1;
    public static final int BONUS_DEFENSA = 1;
    public static final int BONUS_ALCANCE = 1;
 
    private String nombre;
    private int vida;
    private int ataque;
    private int defensa;
    private int alcance;
    private int nivel;
 
    public Personaje(String nombre, int vida, int ataque, int defensa, int alcance) {
        this(nombre, vida, ataque, defensa, alcance, 1);
    }
 
    public Personaje(String nombre, int vida, int ataque, int defensa, int alcance, int nivel) {
        setNombre(nombre);
        setVida(vida);
        setAtaque(ataque);
        setDefensa(defensa);
        setAlcance(alcance);
        setNivel(nivel);
    }
 
    public String getNombre() {
        return nombre;
    }
 
    public int getVida() {
        return vida;
    }
 
    public int getAtaque() {
        return ataque;
    }
 
    public int getDefensa() {
        return defensa;
    }
 
    public int getAlcance() {
        return alcance;
    }
 
    public int getNivel() {
        return nivel;
    }
 
    public void setNombre(String nombre) {
        if (nombre == null || nombre.trim().isEmpty()) {
            throw new IllegalArgumentException("El nombre del personaje no puede estar vacío.");
        }
        if (nombre.contains(";")) {
            throw new IllegalArgumentException("El nombre no puede contener el caracter ';'.");
        }
        this.nombre = nombre.trim();
    }
 
    public void setVida(int vida) {
        this.vida = validarPositivo(vida, "vida");
    }
 
    public void setAtaque(int ataque) {
        this.ataque = validarPositivo(ataque, "ataque");
    }
 
    public void setDefensa(int defensa) {
        this.defensa = validarPositivo(defensa, "defensa");
    }
 
    public void setAlcance(int alcance) {
        this.alcance = validarPositivo(alcance, "alcance");
    }
 
    public void setNivel(int nivel) {
        this.nivel = validarPositivo(nivel, "nivel");
    }
 
    private int validarPositivo(int valor, String campo) {
        if (valor <= 0) {
            throw new IllegalArgumentException(
                    "El valor de " + campo + " debe ser un entero mayor que cero (recibido: " + valor + ").");
        }
        return valor;
    }
 
    public int getValor(String atributo) {
        switch (atributo.toLowerCase()) {
            case "vida":
                return vida;
            case "ataque":
                return ataque;
            case "defensa":
                return defensa;
            case "alcance":
                return alcance;
            case "nivel":
                return nivel;
            default:
                throw new IllegalArgumentException("Atributo desconocido: " + atributo);
        }
    }
 
    public void setValor(String atributo, int valor) {
        switch (atributo.toLowerCase()) {
            case "vida":
                setVida(valor);
                break;
            case "ataque":
                setAtaque(valor);
                break;
            case "defensa":
                setDefensa(valor);
                break;
            case "alcance":
                setAlcance(valor);
                break;
            default:
                throw new IllegalArgumentException("Atributo no modificable: " + atributo);
        }
    }
 
    public void subirNivel() {
        nivel++;
        vida += BONUS_VIDA;
        ataque += BONUS_ATAQUE;
        defensa += BONUS_DEFENSA;
        alcance += BONUS_ALCANCE;
    }
 
    public String toLinea() {
        return nombre + ";" + vida + ";" + ataque + ";" + defensa + ";" + alcance + ";" + nivel;
    }
 
    public static Personaje desdeLinea(String linea) {
        String[] partes = linea.split(";");
        if (partes.length != 5 && partes.length != 6) {
            throw new IllegalArgumentException(
                    "Se esperaban 5 o 6 campos separados por ';' y hay " + partes.length + ".");
        }
        try {
            int nivel = (partes.length == 6) ? Integer.parseInt(partes[5].trim()) : 1;
            return new Personaje(
                    partes[0],
                    Integer.parseInt(partes[1].trim()),
                    Integer.parseInt(partes[2].trim()),
                    Integer.parseInt(partes[3].trim()),
                    Integer.parseInt(partes[4].trim()),
                    nivel);
        } catch (NumberFormatException e) {
            throw new IllegalArgumentException("Los atributos deben ser números enteros.");
        }
    }
 
    @Override
    public String toString() {
        return String.format("%-12s | Nivel: %-2d | Vida: %-3d | Ataque: %-3d | Defensa: %-3d | Alcance: %-3d",
                nombre, nivel, vida, ataque, defensa, alcance);
    }
}


