package Ejercicio1;

public class Personaje {
 
    private String nombre;
    private int vida;
    private int ataque;
    private int defensa;
    private int alcance;
 
    public Personaje(String nombre, int vida, int ataque, int defensa, int alcance) {
        setNombre(nombre);
        setVida(vida);
        setAtaque(ataque);
        setDefensa(defensa);
        setAlcance(alcance);
    }
    
    public String getNombre() {
        return nombre;
    }
    public int getVida() {
        return vida;
    }
    public int getAtaque() {
        return ataque;
    }
    public int getDefensa() {
        return defensa;
    }
    public int getAlcance() {
        return alcance;
    }
    
    public void setNombre(String nombre) {
        if (nombre == null || nombre.trim().isEmpty()) {
            throw new IllegalArgumentException("El nombre del personaje no puede estar vacío.");
        }
        if (nombre.contains(";")) {
            throw new IllegalArgumentException("El nombre no puede contener el caracter ';'.");
        }
        this.nombre = nombre.trim();
    }
 
    public void setVida(int vida) {
        this.vida = validarPositivo(vida, "vida");
    }
 
    public void setAtaque(int ataque) {
        this.ataque = validarPositivo(ataque, "ataque");
    }
 
    public void setDefensa(int defensa) {
        this.defensa = validarPositivo(defensa, "defensa");
    }
 
    public void setAlcance(int alcance) {
        this.alcance = validarPositivo(alcance, "alcance");
    }
 
    private int validarPositivo(int valor, String campo) {
        if (valor <= 0) {
            throw new IllegalArgumentException(
                    "El valor de " + campo + " debe ser un entero mayor que cero (recibido: " + valor + ").");
        }
        return valor;
    }
 
    public String toLinea() {
        return nombre + ";" + vida + ";" + ataque + ";" + defensa + ";" + alcance;
    }
 
    public static Personaje desdeLinea(String linea) {
        String[] partes = linea.split(";");
        if (partes.length != 5) {
            throw new IllegalArgumentException("Se esperaban 5 campos separados por ';' y hay " + partes.length + ".");
        }
        try {
            return new Personaje(
                    partes[0],
                    Integer.parseInt(partes[1].trim()),
                    Integer.parseInt(partes[2].trim()),
                    Integer.parseInt(partes[3].trim()),
                    Integer.parseInt(partes[4].trim()));
        } catch (NumberFormatException e) {
            throw new IllegalArgumentException("Los atributos deben ser números enteros.");
        }
    }
 
    @Override
    public String toString() {
        return String.format("%-12s | Vida: %-3d | Ataque: %-3d | Defensa: %-3d | Alcance: %-3d",
                nombre, vida, ataque, defensa, alcance);
    }
}

