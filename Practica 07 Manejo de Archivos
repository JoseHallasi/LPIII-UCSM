package lab7;

import java.io.DataInputStream;
import java.io.DataOutputStream;
import java.io.EOFException;
import java.io.IOException;
import java.nio.file.Files;
import java.nio.file.Path;
import java.util.Scanner;

public class Binario2 {

    public static void main(String[] args) {
        Path archivo = Path.of("matriz.dat");

        try (Scanner sc = new Scanner(System.in)) {
            System.out.print("Número de filas: ");
            int filas = sc.nextInt();

            System.out.print("Número de columnas: ");
            int columnas = sc.nextInt();

            if (filas <= 0 || columnas <= 0) {
                System.out.println("Las filas y columnas deben ser mayores que cero.");
                return;
            }

            double[][] matriz = new double[filas][columnas];

            System.out.println("Introduce los valores de la matriz:");

            for (int i = 0; i < filas; i++) {
                for (int j = 0; j < columnas; j++) {
                    System.out.print("Matriz[" + i + "][" + j + "]: ");
                    matriz[i][j] = sc.nextDouble();
                }
            }

            // Guardar las dimensiones y los valores en el archivo binario
            try (DataOutputStream salida =
                     new DataOutputStream(Files.newOutputStream(archivo))) {

                salida.writeInt(filas);
                salida.writeInt(columnas);

                for (int i = 0; i < filas; i++) {
                    for (int j = 0; j < columnas; j++) {
                        salida.writeDouble(matriz[i][j]);
                    }
                }
            }

            System.out.println("\nMatriz guardada en: " + archivo.toAbsolutePath());

            // Leer la matriz del archivo binario
            try (DataInputStream entrada =
                     new DataInputStream(Files.newInputStream(archivo))) {

                int filasLeidas = entrada.readInt();
                int columnasLeidas = entrada.readInt();

                System.out.println("\nMatriz leída del archivo:");

                for (int i = 0; i < filasLeidas; i++) {
                    for (int j = 0; j < columnasLeidas; j++) {
                        System.out.print(entrada.readDouble() + "\t");
                    }
                    System.out.println();
                }
            }

        } catch (EOFException e) {
            System.out.println("El archivo terminó antes de poder leer todos los datos.");
        } catch (IOException e) {
            System.out.println("Error al trabajar con el archivo: " + e.getMessage());
        }
    }
}





