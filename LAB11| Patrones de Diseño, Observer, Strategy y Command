package Ejercicio2;
import java.util.ArrayList;
import java.util.LinkedHashMap;
import java.util.List;
import java.util.Map;

class DescuentoPorcentual implements EstrategiaDescuento {
    public double calcularTotal(List<Producto> productos) {
        double total = Utilidades.sumar(productos);

        Map<String, List<Producto>> grupos = new LinkedHashMap<>();
        for (Producto p : productos) {
            String clave = p.getNombre().toLowerCase() + "|" + p.getPrecio();
            grupos.computeIfAbsent(clave, k -> new ArrayList<>()).add(p);
        }

        for (List<Producto> grupo : grupos.values()) {
            int parejas = grupo.size() / 2;
            double precio = grupo.get(0).getPrecio();
            total -= parejas * 2 * precio * 0.30;
        }
        return total;
    }

    public String getNombre() {
        return "Descuento porcentual (2 productos iguales: 30%)";
    }
}

