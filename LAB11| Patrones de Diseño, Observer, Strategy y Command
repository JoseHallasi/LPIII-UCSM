package Ejercicio1;
import java.util.Scanner;
import java.util.ArrayList;
import java.util.List;

public class Main {

    private static List<Usuario> usuarios = new ArrayList<>();
    private static SistemaNotificaciones sistema = new SistemaNotificaciones();
    private static Scanner scanner = new Scanner(System.in);

    public static void main(String[] args) {
        int opcion;

        do {
            mostrarMenu();
            opcion = leerEntero();

            switch (opcion) {
                case 1:
                    registrarUsuario();
                    break;
                case 2:
                    suscribirUsuario();
                    break;
                case 3:
                    desuscribirUsuario();
                    break;
                case 4:
                    enviarNotificacion();
                    break;
                case 5:
                    listarUsuarios();
                    break;
                case 6:
                    verHistorial();
                    break;
                case 0:
                    System.out.println("Saliendo del sistema...");
                    break;
                default:
                    System.out.println("Opción no válida.");
            }
        } while (opcion != 0);
    }

    private static void mostrarMenu() {
        System.out.println("\n===== SISTEMA DE NOTIFICACIONES =====");
        System.out.println("1. Registrar usuario");
        System.out.println("2. Suscribir usuario");
        System.out.println("3. Desuscribir usuario");
        System.out.println("4. Enviar notificación");
        System.out.println("5. Listar usuarios y suscripciones");
        System.out.println("6. Ver historial de un usuario");
        System.out.println("0. Salir");
        System.out.print("Elija una opción: ");
    }

    private static void registrarUsuario() {
        System.out.print("Nombre del usuario: ");
        String nombre = scanner.nextLine().trim();

        if (nombre.isEmpty()) {
            System.out.println("El nombre no puede estar vacío.");
        } else if (buscarUsuario(nombre) != null) {
            System.out.println("Ya existe un usuario con ese nombre.");
        } else {
            usuarios.add(new Usuario(nombre));
            System.out.println("Usuario registrado: " + nombre);
        }
    }

    private static void suscribirUsuario() {
        Usuario usuario = pedirUsuario();
        if (usuario == null) {
            return;
        }
        if (sistema.estaSuscrito(usuario)) {
            System.out.println(usuario.getNombre() + " ya está suscrito.");
        } else {
            sistema.attach(usuario);
            System.out.println(usuario.getNombre() + " se suscribió correctamente.");
        }
    }

    private static void desuscribirUsuario() {
        Usuario usuario = pedirUsuario();
        if (usuario == null) {
            return;
        }
        if (!sistema.estaSuscrito(usuario)) {
            System.out.println(usuario.getNombre() + " no está suscrito.");
        } else {
            sistema.detach(usuario);
            System.out.println(usuario.getNombre() + " se desuscribió correctamente.");
        }
    }

    private static void enviarNotificacion() {
        if (sistema.cantidadSuscriptores() == 0) {
            System.out.println("No hay usuarios suscritos.");
            return;
        }

        System.out.println("Tipo de notificación: 1. Promoción  2. Actualización de producto");
        System.out.print("Elija el tipo: ");
        int tipo = leerEntero();

        String nombreTipo;
        if (tipo == 1) {
            nombreTipo = "Promoción";
        } else if (tipo == 2) {
            nombreTipo = "Actualización";
        } else {
            System.out.println("Tipo no válido.");
            return;
        }

        System.out.print("Mensaje: ");
        String mensaje = scanner.nextLine().trim();

        if (mensaje.isEmpty()) {
            System.out.println("El mensaje no puede estar vacío.");
            return;
        }

        System.out.println("\nEnviando notificación...");
        sistema.notifyObservers(new Notificacion(nombreTipo, mensaje));
    }

    private static void listarUsuarios() {
        if (usuarios.isEmpty()) {
            System.out.println("No hay usuarios registrados.");
            return;
        }
        System.out.println("\nUsuarios registrados:");
        for (Usuario u : usuarios) {
            String estado = sistema.estaSuscrito(u) ? "Suscrito" : "No suscrito";
            System.out.println("- " + u.getNombre() + " (" + estado + ")");
        }
    }

    private static void verHistorial() {
        Usuario usuario = pedirUsuario();
        if (usuario == null) {
            return;
        }
        if (usuario.getHistorial().isEmpty()) {
            System.out.println(usuario.getNombre() + " no ha recibido notificaciones.");
            return;
        }
        System.out.println("Historial de " + usuario.getNombre() + ":");
        for (Notificacion n : usuario.getHistorial()) {
            System.out.println("- " + n);
        }
    }

    private static Usuario pedirUsuario() {
        System.out.print("Nombre del usuario: ");
        String nombre = scanner.nextLine().trim();
        Usuario usuario = buscarUsuario(nombre);
        if (usuario == null) {
            System.out.println("El usuario no está registrado.");
        }
        return usuario;
    }

    private static Usuario buscarUsuario(String nombre) {
        for (Usuario u : usuarios) {
            if (u.getNombre().equalsIgnoreCase(nombre)) {
                return u;
            }
        }
        return null;
    }

    private static int leerEntero() {
        try {
            return Integer.parseInt(scanner.nextLine().trim());
        } catch (NumberFormatException e) {
            return -1;
        }
    }
}

