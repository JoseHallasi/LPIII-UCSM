class NavegacionFavoritos implements EstrategiaCanal {
    private int[] favoritos = {2, 5, 9, 13, 18};

    public int siguiente(int actual) {
        for (int canal : favoritos) {
            if (canal > actual) {
                return canal;
            }
        }
        return favoritos[0]; 
    }

    public int anterior(int actual) {
        for (int i = favoritos.length - 1; i >= 0; i--) {
            if (favoritos[i] < actual) {
                return favoritos[i];
            }
        }
        return favoritos[favoritos.length - 1]; 
    }

