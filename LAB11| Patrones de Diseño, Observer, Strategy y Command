package Ejercicio1;
import java.util.ArrayList;
import java.util.List;

class SistemaNotificaciones {
    private List<Observer> suscriptores = new ArrayList<>();

    public void attach(Observer observer) {
        if (!suscriptores.contains(observer)) {
            suscriptores.add(observer);
        }
    }

    public void detach(Observer observer) {
        suscriptores.remove(observer);
    }

    public boolean estaSuscrito(Observer observer) {
        return suscriptores.contains(observer);
    }

    public int cantidadSuscriptores() {
        return suscriptores.size();
    }

    public void notifyObservers(Notificacion notificacion) {
        for (Observer observer : suscriptores) {
            observer.update(notificacion);
        }
    }
}

