package Ejercicio3;

class Televisor extends Subject {
    private boolean encendido = false;
    private int volumen = 10;
    private int canal = 1;
    private EstrategiaCanal estrategiaCanal = new NavegacionSecuencial();

    public boolean isEncendido() {
        return encendido;
    }

    public int getVolumen() {
        return volumen;
    }

    public int getCanal() {
        return canal;
    }

    public EstrategiaCanal getEstrategiaCanal() {
        return estrategiaCanal;
    }

    public void setEstrategiaCanal(EstrategiaCanal estrategia) {
        this.estrategiaCanal = estrategia;
        notifyObservers("Navegación de canales: " + estrategia.getNombre());
    }

    public void setEncendido(boolean encendido) {
        this.encendido = encendido;
        notifyObservers(encendido ? "Televisor encendido" : "Televisor apagado");
    }

    public void alternarEncendido() {
        setEncendido(!encendido);
    }

    public void setVolumen(int volumen) {
        this.volumen = volumen;
        notifyObservers("Volumen: " + volumen);
    }

    public void setCanal(int canal) {
        this.canal = canal;
        notifyObservers("Canal: " + canal);
    }

    public boolean subirVolumen() {
        if (!verificarEncendido()) {
            return false;
        }
        if (volumen >= 100) {
            notifyObservers("El volumen ya está al máximo");
            return false;
        }
        setVolumen(volumen + 5);
        return true;
    }

    public boolean bajarVolumen() {
        if (!verificarEncendido()) {
            return false;
        }
        if (volumen <= 0) {
            notifyObservers("El volumen ya está al mínimo");
            return false;
        }
        setVolumen(volumen - 5);
        return true;
    }

    public boolean canalSiguiente() {
        if (!verificarEncendido()) {
            return false;
        }
        setCanal(estrategiaCanal.siguiente(canal));
        return true;
    }

    public boolean canalAnterior() {
        if (!verificarEncendido()) {
            return false;
        }
        setCanal(estrategiaCanal.anterior(canal));
        return true;
    }

    private boolean verificarEncendido() {
        if (!encendido) {
            notifyObservers("Acción ignorada: el televisor está apagado");
        }
        return encendido;
    }
}



