class DescuentoPorcentualAcumulado implements EstrategiaDescuento {
    public double calcularTotal(List<Producto> productos) {
        double total = Utilidades.sumar(productos);

        if (productos.size() >= 3) {
            double menorPrecio = productos.get(0).getPrecio();
            for (Producto p : productos) {
                if (p.getPrecio() < menorPrecio) {
                    menorPrecio = p.getPrecio();
                }
            }
            total -= menorPrecio * 0.50;
        }
        return total;
    }

    public String getNombre() {
        return "Descuento porcentual acumulado (3 o más: 50% al más barato)";
    }
}

