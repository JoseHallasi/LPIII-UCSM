package lab08;

import java.sql.Connection;
import java.sql.DriverManager;
import java.sql.PreparedStatement;
import java.sql.ResultSet;
import java.sql.SQLException;
import java.sql.Statement;

public class Principal {

    private static final String URL = "jdbc:sqlite:estudiantes.db";

    public static void main(String[] args) {
        try {
            Class.forName("org.sqlite.JDBC");
            try (Connection con = DriverManager.getConnection(URL)) {
                System.out.println("Se creó y/o abrió la base de datos.");

                crearTabla(con);

                System.out.println("\n--- 1. INSERTAR (PreparedStatement) ---");
                insertar(con, 1, "Carlos", 20);
                insertar(con, 2, "Bety", 22);
                insertar(con, 3, "Laura", 19);
                listar(con);

                System.out.println("\n--- 2. ACTUALIZAR (PreparedStatement) ");
                actualizar(con, 2, "Beatriz", 23);
                listar(con);

                System.out.println("\n--- 3. BUSCAR POR ID (PreparedStatement) ");
                buscarPorId(con, 3);

                System.out.println("\n--- 4. BORRAR (PreparedStatement) ---");
                borrar(con, 1);
                listar(con);

                System.out.println("\n--- 5. TRANSACCIÓN CON COMMIT ---");
                transaccionCommit(con);
                listar(con);

                System.out.println("\n--- 6. TRANSACCIÓN CON ROLLBACK ---");
                transaccionRollback(con);
                listar(con);
            }
        } catch (Exception e) {
            System.out.println(e);
        }
    }

    static void crearTabla(Connection con) throws SQLException {
        try (Statement stmt = con.createStatement()) {
            stmt.execute("DROP TABLE IF EXISTS estudiante");
            stmt.execute("CREATE TABLE estudiante ("
                    + "id INTEGER PRIMARY KEY, "
                    + "nombre TEXT NOT NULL, "
                    + "edad INTEGER)");
            System.out.println("Creación de tabla exitosa");
        }
    }

    static void insertar(Connection con, int id, String nombre, int edad) throws SQLException {
        String sql = "INSERT INTO estudiante (id, nombre, edad) VALUES (?, ?, ?)";
        try (PreparedStatement ps = con.prepareStatement(sql)) {
            ps.setInt(1, id);
            ps.setString(2, nombre);
            ps.setInt(3, edad);
            int filas = ps.executeUpdate();
            System.out.println(filas + " registro(s) insertado(s): " + nombre);
        }
    }

    static void listar(Connection con) throws SQLException {
        try (Statement stmt = con.createStatement();
             ResultSet rs = stmt.executeQuery("SELECT * FROM estudiante")) {
            System.out.println("ID | NOMBRE | EDAD");
            while (rs.next()) {
                System.out.println(rs.getInt(1) + " | " + rs.getString(2) + " | " + rs.getInt(3));
            }
        }
    }

    static void buscarPorId(Connection con, int id) throws SQLException {
        String sql = "SELECT * FROM estudiante WHERE id = ?";
        try (PreparedStatement ps = con.prepareStatement(sql)) {
            ps.setInt(1, id);
            try (ResultSet rs = ps.executeQuery()) {
                if (rs.next()) {
                    System.out.println("Encontrado: " + rs.getInt("id") + " | "
                            + rs.getString("nombre") + " | " + rs.getInt("edad"));
                } else {
                    System.out.println("No existe el registro con id " + id);
                }
            }
        }
    }

    static void actualizar(Connection con, int id, String nombre, int edad) throws SQLException {
        String sql = "UPDATE estudiante SET nombre = ?, edad = ? WHERE id = ?";
        try (PreparedStatement ps = con.prepareStatement(sql)) {
            ps.setString(1, nombre);
            ps.setInt(2, edad);
            ps.setInt(3, id);
            int filas = ps.executeUpdate();
            System.out.println(filas + " registro(s) actualizado(s)");
        }
    }

    static void borrar(Connection con, int id) throws SQLException {
        String sql = "DELETE FROM estudiante WHERE id = ?";
        try (PreparedStatement ps = con.prepareStatement(sql)) {
            ps.setInt(1, id);
            int filas = ps.executeUpdate();
            System.out.println(filas + " registro(s) borrado(s)");
        }
    }

    static void transaccionCommit(Connection con) throws SQLException {
        con.setAutoCommit(false);
        try {
            insertar(con, 190, "Jose", 21);
            insertar(con, 191, "Diana", 24);
            con.commit();
            System.out.println("Commit realizado: los datos quedaron guardados.");
        } catch (SQLException e) {
            con.rollback();
            System.out.println("Error, se hizo rollback: " + e.getMessage());
        } finally {
            con.setAutoCommit(true);
        }
    }

    static void transaccionRollback(Connection con) throws SQLException {
        con.setAutoCommit(false);
        try {
            insertar(con, 200, "Andy", 25);
            con.rollback();
            System.out.println("Rollback realizado: Andy NO quedó guardado.");
        } finally {
            con.setAutoCommit(true);
        }
    }
}

