package Ejercicio2;

import java.sql.*;
import java.util.ArrayList;
 
public class Gestora {
 
    private ArrayList<Alumno> alumnos = new ArrayList<Alumno>();
 
    public void cargar(Connection con) throws Exception {
        alumnos.clear();
        Statement stmt = con.createStatement();
        ResultSet rs = stmt.executeQuery("SELECT * FROM alumno");
        while (rs.next())
            alumnos.add(new Alumno(rs.getInt(1), rs.getString(2), rs.getInt(3), rs.getString(4)));
    }
 
    private int compararConValor(Alumno a, String campo, String valor) {
        if (campo.equals("id"))
            return Integer.compare(a.getId(), Integer.parseInt(valor));
        if (campo.equals("edad"))
            return Integer.compare(a.getEdad(), Integer.parseInt(valor));
        if (campo.equals("nombre"))
            return a.getNombre().compareToIgnoreCase(valor);
        return a.getCarrera().compareToIgnoreCase(valor);
    }
 
    private int compararAlumnos(Alumno a, Alumno b, String campo) {
        if (campo.equals("id"))
            return Integer.compare(a.getId(), b.getId());
        if (campo.equals("edad"))
            return Integer.compare(a.getEdad(), b.getEdad());
        if (campo.equals("nombre"))
            return a.getNombre().compareToIgnoreCase(b.getNombre());
        return a.getCarrera().compareToIgnoreCase(b.getCarrera());
    }
 
    private boolean cumple(int resultado, String operador) {
        if (operador.equals("="))
            return resultado == 0;
        if (operador.equals(">"))
            return resultado > 0;
        if (operador.equals("<"))
            return resultado < 0;
        if (operador.equals(">="))
            return resultado >= 0;
        if (operador.equals("<="))
            return resultado <= 0;
        if (operador.equals("!="))
            return resultado != 0;
        return false;
    }
 
    public void consultar(String[] campos, String campoCondicion, String operador, String valor,
            String campoOrden, boolean ascendente, int limite) {
 
        ArrayList<Alumno> resultado = new ArrayList<Alumno>();
 
        for (Alumno a : alumnos) {
            if (campoCondicion.equals("") || cumple(compararConValor(a, campoCondicion, valor), operador))
                resultado.add(a);
        }
 
        if (!campoOrden.equals("")) {
            for (int i = 0; i < resultado.size() - 1; i++) {
                for (int j = 0; j < resultado.size() - 1 - i; j++) {
                    int r = compararAlumnos(resultado.get(j), resultado.get(j + 1), campoOrden);
                    if (!ascendente)
                        r = -r;
                    if (r > 0) {
                        Alumno auxiliar = resultado.get(j);
                        resultado.set(j, resultado.get(j + 1));
                        resultado.set(j + 1, auxiliar);
                    }
                }
            }
        }
 
        int cantidad = resultado.size();
        if (limite > 0 && limite < cantidad)
            cantidad = limite;
 
        for (int i = 0; i < cantidad; i++) {
            Alumno a = resultado.get(i);
            String linea = "";
            for (String campo : campos) {
                if (campo.equals("id"))
                    linea += a.getId() + " ";
                if (campo.equals("nombre"))
                    linea += a.getNombre() + " ";
                if (campo.equals("edad"))
                    linea += a.getEdad() + " ";
                if (campo.equals("carrera"))
                    linea += a.getCarrera() + " ";
            }
            System.out.println(linea);
        }
    }
}

