package guides.guide10.exercise2;

import javax.swing.JPanel;

import java.awt.Color;
import java.awt.Graphics;
import java.awt.Graphics2D;
import java.awt.RenderingHints;

public class GraficoTemperatura extends JPanel {

    private final String[] dias = {
        "Lun", "Mar", "Mié", "Jue","Vie", "Sáb", "Dom"
    };
    private double[] temperaturas = new double[7];

    public void actualizar(double[] temperaturas) {

        this.temperaturas = temperaturas.clone();

        repaint();
    }
    @Override
    protected void paintComponent(Graphics graphics) {

        super.paintComponent(graphics);

        Graphics2D g = (Graphics2D) graphics;

        g.setRenderingHint(
            RenderingHints.KEY_ANTIALIASING,
            RenderingHints.VALUE_ANTIALIAS_ON
        );
        int left = 45;
        int bottom = getHeight() - 35;
        int top = 25;
        int width = Math.max(1, getWidth() - left - 20);
        int height = Math.max(1, bottom - top);

        // Dibujar los ejes
        g.setColor(Color.BLACK);
        g.drawLine(left, top, left, bottom);
        g.drawLine(left, bottom, getWidth() - 20, bottom);
        // Encontrar temperatura mínima y máxima
        double minimum = temperaturas[0];
        double maximum = temperaturas[0];
        for (double temperature : temperaturas) {
            minimum = Math.min(minimum, temperature);
            maximum = Math.max(maximum, temperature);
        }
        if (minimum == maximum) {

            minimum--;
            maximum++;

        }
        int previousX = 0;
        int previousY = 0;

        // Dibujar los puntos y las líneas del gráfico
        for (int i = 0; i < temperaturas.length; i++) {

            int x = left + i * width / (temperaturas.length - 1);

            int y = bottom - (int) (
                (temperaturas[i] - minimum) /
                (maximum - minimum) * height
            );
            // Unir los puntos con líneas
            if (i > 0) {
                g.setColor(Color.BLUE);
                g.drawLine(
                    previousX,
                    previousY,
                    x,y
                );
            }
            // Dibujar los puntos
            g.setColor(Color.RED);
            g.fillOval(x - 4, y - 4, 8, 8);
            // Mostrar los días
            g.setColor(Color.BLACK);
            g.drawString(dias[i], x - 10, bottom + 20);
            // Mostrar las temperaturas
            g.drawString(
                String.format("%.1f", temperaturas[i]),
                x - 12,y - 8
            );
            previousX = x;
            previousY = y;

        }
    }
}


