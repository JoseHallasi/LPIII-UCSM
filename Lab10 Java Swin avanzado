        JFrame frame = new JFrame("Gestión de Producto");
        frame.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        frame.setSize(500, 500);

        Producto producto = new Producto("Produto", 0.00, 0, "Categoria");

        JTextField nombreField = new JTextField(producto.getNombre(), 15);
        JTextField precioField = new JTextField(String.valueOf(producto.getPrecio()), 15);
        JTextField stockField = new JTextField(String.valueOf(producto.getCantidadStock()), 15);
        JTextField categoriaField = new JTextField(producto.getCategoria(), 15);

        JButton button = new JButton("Actualizar Producto");
        JLabel infoLabel = new JLabel("Producto: " + producto.getNombre() + " - Precio: " + producto.getPrecio() + " - Stock: " + producto.getCantidadStock() + " - Categoría: " + producto.getCategoria());

        button.addActionListener(new ActionListener() {
            @Override
            public void actionPerformed(ActionEvent e) {
                producto.setNombre(nombreField.getText());
                producto.setCategoria(categoriaField.getText());

                try {
                    double precio = Double.parseDouble(precioField.getText());
                    if (precio < 0) {
                        JOptionPane.showMessageDialog(frame, "El precio no puede ser negativo.");
                    } else {
                        producto.setPrecio(precio);
                    }
                } catch (NumberFormatException ex) {
                    JOptionPane.showMessageDialog(frame, "Por favor, ingrese un número válido para el precio.");
                }

                try {
                    int stock = Integer.parseInt(stockField.getText());
                    if (stock < 0) {
                        JOptionPane.showMessageDialog(frame, "El stock no puede ser negativo.");
                    } else {
                        producto.setCantidadStock(stock);
                    }
                } catch (NumberFormatException ex) {
                    JOptionPane.showMessageDialog(frame, "Por favor, ingrese un número válido para el stock.");
                }

                infoLabel.setText("Producto: " + producto.getNombre() + " - Precio: " + producto.getPrecio() + " - Stock: " + producto.getCantidadStock() + " - Categoría: " + producto.getCategoria());
            }
        });

        frame.setLayout(new java.awt.FlowLayout());
        frame.add(new JLabel("Nombre:"));
        frame.add(nombreField);
        frame.add(new JLabel("Precio:"));
        frame.add(precioField);
        frame.add(new JLabel("Stock:"));
        frame.add(stockField);
        frame.add(new JLabel("Categoría:"));
        frame.add(categoriaField);
        frame.add(button);
        frame.add(infoLabel);

        frame.setVisible(true);
    }
