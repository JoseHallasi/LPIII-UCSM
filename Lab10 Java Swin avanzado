import javax.swing.*;
import java.awt.*;

public class PanelGrafico extends JPanel {
    private int[] temperaturas = {0, 0, 0, 0, 0, 0, 0};
    private String[] dias = {"Lun", "Mar", "Mie", "Jue", "Vie", "Sab", "Dom"};
    public void setTemperaturas(int[] temps) {
        this.temperaturas = temps;
        repaint();
    }
    @Override
    protected void paintComponent(Graphics g) {
        super.paintComponent(g);
        Graphics2D g2d = (Graphics2D) g;
        g2d.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
        int xInicio = 50;
        int espacioX = 55;
        int baseY = 250;
        g2d.setColor(Color.BLACK);
        g2d.drawLine(xInicio - 10, baseY, xInicio + 6 * espacioX + 20, baseY);

        for (int i = 0; i < 7; i++) {
            int x = xInicio + (i * espacioX);
            int y = baseY - (temperaturas[i] * 3);
            g2d.setColor(Color.RED);
            g2d.fillOval(x - 4, y - 4, 8, 8);
            g2d.setColor(Color.BLACK);
            g2d.drawString(String.valueOf(temperaturas[i]), x - 10, y - 10);
            g2d.drawString(dias[i], x - 10, baseY + 20);
            if (i < 6) {
                int siguienteX = xInicio + ((i + 1) * espacioX);
                int siguienteY = baseY - (temperaturas[i + 1] * 3);
                g2d.setColor(Color.BLACK);
                g2d.drawLine(x, y, siguienteX, siguienteY);
            }
        }
    }
}

