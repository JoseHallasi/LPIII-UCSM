package Ejercicio4;

import javax.sound.sampled.*;
import javax.swing.*;
import java.awt.FlowLayout;
import java.io.File;
import java.io.IOException;

public class AppReproductorMusica {

    private static Clip clip;              
    private static long posicionPausa = 0;    
    private static boolean pausado = false;   

    public static void main(String[] args) {
        JFrame frame = new JFrame("Reproductor de Música");
        frame.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        frame.setSize(400, 150);
        frame.setLayout(new FlowLayout());

        JButton reproducirButton = new JButton("Reproducir");
        JButton pausarButton = new JButton("Pausar");
        JButton reanudarButton = new JButton("Reanudar");

        reproducirButton.addActionListener(e -> reproducir("musica.wav"));
        pausarButton.addActionListener(e -> pausar());
        reanudarButton.addActionListener(e -> reanudar());

        frame.add(reproducirButton);
        frame.add(pausarButton);
        frame.add(reanudarButton);

        frame.setVisible(true);
    }

    public static void reproducir(String filePath) {
        try {
            if (clip != null) {
                clip.stop();
                clip.close();
            }

            File audioFile = new File(filePath);
            AudioInputStream audioStream = AudioSystem.getAudioInputStream(audioFile);
            clip = AudioSystem.getClip();
            clip.open(audioStream);

            pausado = false;
            posicionPausa = 0;
            clip.setMicrosecondPosition(0); 
            clip.start();
        } catch (UnsupportedAudioFileException | IOException | LineUnavailableException e) {
            JOptionPane.showMessageDialog(null,
                    "No se pudo reproducir el archivo: " + filePath);
            e.printStackTrace();
        }
    }

    public static void pausar() {
        if (clip != null && clip.isRunning()) {
            posicionPausa = clip.getMicrosecondPosition();
            clip.stop();
            pausado = true;
        }
    }

    public static void reanudar() {
        if (clip != null && pausado) {
            clip.setMicrosecondPosition(posicionPausa);
            clip.start();
            pausado = false;
        }
    }
}

