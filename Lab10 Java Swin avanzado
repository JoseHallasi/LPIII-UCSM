package guides.guide10.exercise2;

import javax.swing.JButton;
import javax.swing.JFrame;
import javax.swing.JLabel;
import javax.swing.JOptionPane;
import javax.swing.JPanel;
import javax.swing.JTextField;
import javax.swing.SwingUtilities;

import java.awt.BorderLayout;
import java.awt.GridLayout;

public class TemperaturaApp extends JFrame {

    private final JTextField[] entradas = new JTextField[7];
    private final GraficoTemperatura grafico = new GraficoTemperatura();

    public TemperaturaApp() {

        setTitle("Temperatura semanal");
        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        setSize(700, 450);
        setLayout(new BorderLayout());

        JPanel formulario = new JPanel(new GridLayout(2, 8, 5, 5));

        String[] dias = {"Lun", "Mar", "Mié", "Jue", "Vie", "Sáb", "Dom"};

        // Crear etiquetas de los días
        for (int i = 0; i < dias.length; i++) {
            formulario.add(new JLabel(dias[i], JLabel.CENTER));
        }

        formulario.add(new JLabel());

        // Crear campos de entrada
        for (int i = 0; i < entradas.length; i++) {
            entradas[i] = new JTextField();
            formulario.add(entradas[i]);
        }

        // Crear botón
        JButton mostrar = new JButton("Mostrar Gráfico");

        mostrar.addActionListener(event -> mostrarGrafico());

        formulario.add(mostrar);

        // Agregar componentes a la ventana
        add(formulario, BorderLayout.NORTH);
        add(grafico, BorderLayout.CENTER);
    }

    private void mostrarGrafico() {

        try {

            double[] temperaturas = new double[entradas.length];

            for (int i = 0; i < entradas.length; i++) {
                temperaturas[i] = Double.parseDouble(
                    entradas[i].getText()
                );
            }
            grafico.actualizar(temperaturas);

        } catch (NumberFormatException exception) {

            JOptionPane.showMessageDialog(
                this,
                "Ingrese una temperatura válida en cada campo"
            );
        }
    }
    public static void main(String[] args) {

        SwingUtilities.invokeLater(() -> {
            new TemperaturaApp().setVisible(true);
        });

    }
}





