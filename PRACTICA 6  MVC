package Ejercicio3;
 
import java.util.Random;
 
public class Enemigo {
 
    public static final String BESTIA = "Bestia", NO_MUERTO = "No-muerto", HUMANOIDE = "Humanoide";
    public static final int ATACAR = 1, DEFENDER = 2, CURARSE = 3;
    private static final Random AZAR = new Random();
 
    private String nombre, tipo;
    private int salud, saludMaxima, nivel;
    private boolean defendiendo;
 
    public Enemigo(String nombre, int nivel, String tipo) {
        this.nombre = nombre;
        this.nivel = nivel;
        this.tipo = tipo;
        this.saludMaxima = 20 + nivel * 10;
        this.salud = saludMaxima;
    }
 
    public static Enemigo aleatorio(int nivelJugador, int numero) {
        int nivel = Math.max(1, nivelJugador + AZAR.nextInt(3) - 1);
        int t = AZAR.nextInt(3);
        if (t == 0) return new Enemigo("Lobo #" + numero, nivel, BESTIA);
        if (t == 1) return new Enemigo("Esqueleto #" + numero, nivel, NO_MUERTO);
        return new Enemigo("Bandido #" + numero, nivel, HUMANOIDE);
    }
 
    public String getNombre() { return nombre; }
    public String getTipo() { return tipo; }
    public int getSalud() { return salud; }
    public int getSaludMaxima() { return saludMaxima; }
    public int getNivel() { return nivel; }
    public boolean estaVivo() { return salud > 0; }
 
    public int elegirAccion() {
        defendiendo = false; // la defensa dura hasta su siguiente turno
        int n = AZAR.nextInt(100);
        if (n < 60) return ATACAR;
        if (n < 80) return DEFENDER;
        return salud < saludMaxima ? CURARSE : ATACAR;
    }
 
    public int atacar() {
        return 2 + nivel + AZAR.nextInt(4) + (tipo.equals(BESTIA) ? 1 : 0);
    }
 
    public int recibirDanio(int danio) {
        int real = defendiendo ? Math.max(1, danio / 2) : danio;
        salud = Math.max(0, salud - real);
        return real;
    }
 
    public void defender() { defendiendo = true; }
 
    public int curarse() {
        int antes = salud;
        salud = Math.min(saludMaxima, salud + 8 + nivel * 3);
        return salud - antes;
    }
}


