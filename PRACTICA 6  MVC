        vista.mostrarInventario(items);
        int numero = vista.solicitarEntero("Numero del item: ");
        // El numero que ve el usuario empieza en 1, la posicion de la lista en 0
        if (numero < 1 || numero > items.size()) {
            vista.mostrarMensaje("Numero de item no valido.");
        } else {
            vista.mostrarDetallesItem(items.get(numero - 1));
        }
    }
 
