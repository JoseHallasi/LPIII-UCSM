import java.util.*;
import java.util.stream.Collectors;

public class PedidoModelo {
    private final List<Pedido> pedidos = new ArrayList<>();
    private final List<Pedido> historial = new ArrayList<>();

    public void agregarPedido(Pedido pedido) {
        pedidos.add(pedido);
    }

    public List<Pedido> getPedidos() {
        return pedidos;
    }

    public List<Pedido> getHistorial() {
        return historial;
    }

    private void registrarEnHistorial(Pedido p, Pedido.Estado estado) {
        Pedido copia = new Pedido(p.getNombrePlato(), p.getTipo());
        copia.setEstado(estado);
        historial.add(copia);
    }

    public boolean eliminarPedido(int indice) {
        if (indice < 0 || indice >= pedidos.size()) return false;
        Pedido p = pedidos.remove(indice);
        p.setEstado(Pedido.Estado.ELIMINADO);
        registrarEnHistorial(p, Pedido.Estado.ELIMINADO);
        return true;
    }

    public boolean actualizarPedido(int indice, String nuevoNombre) {
        if (indice < 0 || indice >= pedidos.size()) return false;
        pedidos.get(indice).setNombrePlato(nuevoNombre);
        return true;
    }

    public boolean completarPedido(int indice) {
        if (indice < 0 || indice >= pedidos.size()) return false;
        Pedido p = pedidos.get(indice);
        if (p.getEstado() == Pedido.Estado.COMPLETO) return false;
        p.setEstado(Pedido.Estado.COMPLETO);
        registrarEnHistorial(p, Pedido.Estado.COMPLETO);
        return true;
    }

    public List<Pedido> buscarPedidos(String texto) {
        String t = texto.toLowerCase();
        return pedidos.stream()
                .filter(p -> p.getNombrePlato().toLowerCase().contains(t)
                          || p.getTipo().toLowerCase().contains(t))
                .collect(Collectors.toList());
    }

    public List<Pedido> filtrarPorEstado(Pedido.Estado estado) {
        return pedidos.stream()
                .filter(p -> p.getEstado() == estado)
                .collect(Collectors.toList());
    }

    public int contarTotal() {
        return pedidos.size();
    }

    public int contarPendientes() {
        return filtrarPorEstado(Pedido.Estado.PENDIENTE).size();
    }

    public Map<String, Long> contarPorTipo() {
        return pedidos.stream().collect(
                Collectors.groupingBy(Pedido::getTipo, TreeMap::new, Collectors.counting()));
    }
}
    


