package Ejercicio3;
 
import java.util.ArrayList;
import java.util.List;
import java.util.Random;
 
public class CombateControlador {
 
    private Jugador jugador;
    private Vista vista;
    private JuegoControlador juego;
    private Random azar = new Random();
 
    public CombateControlador(Jugador jugador, Vista vista, JuegoControlador juego) {
        this.jugador = jugador;
        this.vista = vista;
        this.juego = juego;
    }
 
    public void iniciar() {
        List<Enemigo> enemigos = new ArrayList<>();
        int cantidad = 1 + azar.nextInt(3);
        for (int i = 1; i <= cantidad; i++) enemigos.add(Enemigo.aleatorio(jugador.getNivel(), i));
        vista.msg("\nAparecen " + cantidad + " enemigo(s). Comienza el combate!");
 
        int ronda = 1;
        boolean huyo = false;
        while (jugador.estaVivo() && hayVivos(enemigos) && !huyo) {
            vista.mostrarCombate(jugador, enemigos, ronda);
            String opcion = vista.menuCombate();
            boolean turnoUsado = false;
            if (opcion.equals("1")) turnoUsado = atacar(enemigos);
            else if (opcion.equals("2")) turnoUsado = juego.usarObjeto();
            else if (opcion.equals("3")) huyo = true;
            else vista.msg("Opcion no valida. Intentalo de nuevo.");
 
            if (turnoUsado) {
                if (hayVivos(enemigos)) turnoEnemigos(enemigos);
                ronda++;
            }
        }
 
        if (huyo) {
            vista.msg("\nHuyes del combate.");
        } else if (!jugador.estaVivo()) {
            vista.msg("\nHas sido derrotado... Despiertas en el campamento con la salud restaurada.");
            jugador.recuperarSalud();
        } else {
            jugador.subirNivel();
            vista.msg("\nVICTORIA! Subes al nivel " + jugador.getNivel() + " y recuperas toda tu salud ("
                    + jugador.getSaludMaxima() + ").");
        }
    }
 
    private boolean hayVivos(List<Enemigo> enemigos) {
        for (Enemigo e : enemigos) {
            if (e.estaVivo()) return true;
        }
        return false;
    }
 
    private boolean atacar(List<Enemigo> enemigos) {
        int n = vista.leerEntero("Numero del enemigo a atacar: ");
        if (n < 1 || n > enemigos.size() || !enemigos.get(n - 1).estaVivo()) {
            vista.msg("Ese enemigo no es valido o ya esta derrotado.");
            return false;
        }
        Enemigo e = enemigos.get(n - 1);
        Item arma = jugador.getArma();
        int danio = e.recibirDanio(jugador.atacar());
        vista.msg(">> Atacas a " + e.getNombre() + " con " + (arma == null ? "tus punos" : arma.getNombre())
                + " y le causas " + danio + " de dano.");
        if (!e.estaVivo()) vista.msg(">> " + e.getNombre() + " ha sido derrotado!");
        return true;
    }
 
    private void turnoEnemigos(List<Enemigo> enemigos) {
        vista.msg("\n--- Turno de los enemigos ---");
        for (Enemigo e : enemigos) {
            if (!e.estaVivo() || !jugador.estaVivo()) continue;
            int accion = e.elegirAccion();
            if (accion == Enemigo.ATACAR) {
                int danio = e.atacar();
                jugador.recibirDanio(danio);
                vista.msg("<< " + e.getNombre() + " te ataca y te causa " + danio + " de dano.");
            } else if (accion == Enemigo.DEFENDER) {
                e.defender();
                vista.msg("<< " + e.getNombre() + " se pone en guardia (recibira menos dano).");
            } else {
                vista.msg("<< " + e.getNombre() + " se cura " + e.curarse() + " de salud.");
            }
        }
    }
}


