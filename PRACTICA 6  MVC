            vista.mostrarMensaje("No existe un item con ese nombre.");
        } else if (!item.usarItem()) {
            vista.mostrarMensaje("No quedan unidades de " + item.getNombre() + ".");
        } else if (item.getTipo().equals(Item.TIPO_POCION)) {
            vista.mostrarMensaje("Has usado una pocion: " + item.getNombre()
                    + ". Unidades restantes: " + item.getCantidad());
        } else {
            vista.mostrarMensaje("Has usado el arma: " + item.getNombre());
        }
    }
}


