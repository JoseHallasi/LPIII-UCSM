package Ejercicio3;
 
import java.util.List;
 
public class JuegoControlador {
 
    private Jugador jugador;
    private Vista vista;
    private CombateControlador combate;
 
    public JuegoControlador(Jugador jugador, Vista vista) {
        this.jugador = jugador;
        this.vista = vista;
        this.combate = new CombateControlador(jugador, vista, this);
    }
 
    public void iniciar() {
        String opcion;
        do {
            opcion = vista.menuPrincipal();
            switch (opcion) {
                case "1": verInventario(); break;
                case "2": agregarItem(); break;
                case "3": eliminarItem(); break;
                case "4": buscarItem(); break;
                case "5": vista.mostrarJugador(jugador); break;
                case "6": usarObjeto(); break;
                case "7": combate.iniciar(); break;
                case "0": vista.msg("Saliendo..."); break;
                default: vista.msg("Opcion no valida. Intentalo de nuevo.");
            }
        } while (!opcion.equals("0"));
    }
 
    private void verInventario() {
        List<Item> items = jugador.getInventario();
        if (items.isEmpty()) vista.msg("El inventario esta vacio.");
        else vista.mostrarInventario(items);
    }
 
    private void agregarItem() {
        String nombre = vista.leer("Nombre del item: ");
        int cantidad = vista.leerEntero("Cantidad: ");
        int tipo = vista.leerEntero("Tipo (1 = Arma, 2 = Pocion): ");
        if (tipo != 1 && tipo != 2) {
            vista.msg("Tipo no valido. No se agrego el item.");
            return;
        }
        int valor = vista.leerEntero(tipo == 1 ? "Dano del arma: " : "Salud que recupera: ");
        String descripcion = vista.leer("Descripcion: ");
 
        if (nombre.isEmpty() || cantidad <= 0 || valor <= 0) {
            vista.msg("Nombre, cantidad y valor deben ser validos (cantidad y valor mayores que cero).");
        } else if (jugador.agregarItem(new Item(nombre, cantidad, tipo == 1 ? Item.ARMA : Item.POCION,
                descripcion, valor))) {
            vista.msg("Item agregado: " + nombre);
        } else {
            vista.msg("Ya existe un item con ese nombre.");
        }
    }
 
    private void eliminarItem() {
        Item item = elegirItem("Numero del item a eliminar: ");
        if (item != null && jugador.eliminarItem(item)) vista.msg("Item eliminado: " + item.getNombre());
    }
 
    private void buscarItem() {
        Item item = jugador.buscarItem(vista.leer("Nombre del item a buscar: "));
        if (item == null) vista.msg("No se encontro ningun item con ese nombre.");
        else vista.mostrarItem("", item);
    }
 
    private Item elegirItem(String texto) {
        List<Item> items = jugador.getInventario();
        if (items.isEmpty()) {
            vista.msg("El inventario esta vacio.");
            return null;
        }
        vista.mostrarInventario(items);
        int n = vista.leerEntero(texto);
        if (n < 1 || n > items.size()) {
            vista.msg("Numero no valido.");
            return null;
        }
        return items.get(n - 1);
    }
 
    public boolean usarObjeto() {
        Item item = elegirItem("Numero del objeto a usar: ");
        if (item == null) return false;
        int saludAntes = jugador.getSalud();
        if (!jugador.usarObjeto(item)) {
            vista.msg("No quedan unidades de " + item.getNombre() + ".");
            return false;
        }
        if (item.esPocion()) {
            vista.msg("Usas " + item.getNombre() + " y recuperas " + (jugador.getSalud() - saludAntes)
                    + " de salud. Unidades restantes: " + item.getCantidad());
        } else {
            vista.msg("Equipas " + item.getNombre() + ".");
        }
        return true;
    }
}


