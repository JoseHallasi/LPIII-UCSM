            vista.mostrarMensaje("El nombre del item no puede estar vacio.");
        } else if (cantidad <= 0) {
            vista.mostrarMensaje("La cantidad debe ser mayor que cero.");
        } else if (modelo.agregarItem(new Item(nombre, cantidad, tipo, descripcion))) {
            vista.mostrarMensaje("Item agregado: " + nombre);
        } else {
            vista.mostrarMensaje("Ya existe un item con ese nombre.");
        }
    }
 
    private void eliminarItem() {
        if (modelo.obtenerItems().isEmpty()) {
            vista.mostrarMensaje("El inventario esta vacio, no hay nada que eliminar.");
            return;
        }
        vista.mostrarInventario(modelo.obtenerItems());
        String nombre = vista.solicitarTexto("Nombre del item a eliminar: ");
 
        Item item = modelo.buscarItem(nombre);
        if (item == null) {
            vista.mostrarMensaje("No existe un item con ese nombre.");
        } else if (modelo.eliminarItem(item)) {
            vista.mostrarMensaje("Item eliminado: " + item.getNombre());
        }
