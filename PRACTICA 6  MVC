package Ejercicio1;

import java.util.ArrayList;
import java.util.List;
 
public class CarritoModelo {
 
    public static final double COSTO_ENVIO = 10.0;
    public static final double ENVIO_GRATIS_DESDE = 100.0;
    public static final String CODIGO_DESCUENTO_BASICO = "PROMO10";
    public static final int PORCENTAJE_DESCUENTO_BASICO = 10;
    public static final String CODIGO_DESCUENTO_ESPECIAL = "PROMO20";
    public static final int PORCENTAJE_DESCUENTO_ESPECIAL = 20;
 
    private List<Producto> productos;
    private List<ItemCarrito> carrito;
    private List<Compra> historial;
    private int porcentajeDescuento;
    private int siguienteIdProducto;
    private int siguienteNumeroCompra;
 
    public CarritoModelo() {
        productos = new ArrayList<>();
        carrito = new ArrayList<>();
        historial = new ArrayList<>();
        porcentajeDescuento = 0;
        siguienteIdProducto = 1;
        siguienteNumeroCompra = 1;
    }
  
    public Producto agregarProducto(String nombre, double precio, int stock) {
        Producto producto = new Producto(siguienteIdProducto, nombre, precio, stock);
        siguienteIdProducto++;
        productos.add(producto);
        return producto;
    }
 
    public List<Producto> getProductos() {
        return new ArrayList<>(productos);
    }
 
    // Devuelve null si no existe un producto con ese codigo
    public Producto buscarProductoPorId(int id) {
        for (Producto producto : productos) {
            if (producto.getId() == id) {
                return producto;
            }
        }
        return null;
    }
  
    public boolean agregarAlCarrito(Producto producto, int cantidad) {
        ItemCarrito existente = buscarItem(producto.getId());
        int cantidadEnCarrito = 0;
        if (existente != null) {
            cantidadEnCarrito = existente.getCantidad();
        }
        if (cantidadEnCarrito + cantidad > producto.getStock()) {
            return false;
        }
        if (existente == null) {
            carrito.add(new ItemCarrito(producto, cantidad));
        } else {
            existente.aumentarCantidad(cantidad);
        }
        return true;
    }
 
    public boolean eliminarDelCarrito(int idProducto) {
        for (int i = 0; i < carrito.size(); i++) {
            if (carrito.get(i).getProducto().getId() == idProducto) {
                carrito.remove(i);
                return true;
            }
        }
        return false;
    }
 
    public List<ItemCarrito> getCarrito() {
        return new ArrayList<>(carrito);
    }
 
    public boolean carritoVacio() {
        return carrito.isEmpty();
    }
 
    private ItemCarrito buscarItem(int idProducto) {
        for (ItemCarrito item : carrito) {
            if (item.getProducto().getId() == idProducto) {
                return item;
            }
        }
        return null;
    }
  
    public boolean aplicarDescuento(String codigo) {
        if (codigo.equalsIgnoreCase(CODIGO_DESCUENTO_BASICO)) {
            porcentajeDescuento = PORCENTAJE_DESCUENTO_BASICO;
            return true;
        }
        if (codigo.equalsIgnoreCase(CODIGO_DESCUENTO_ESPECIAL)) {
            porcentajeDescuento = PORCENTAJE_DESCUENTO_ESPECIAL;
            return true;
        }
        return false;
    }
 
    public int getPorcentajeDescuento() {
        return porcentajeDescuento;
    }
 
    public double calcularSubtotal() {
        double subtotal = 0;
        for (ItemCarrito item : carrito) {
            subtotal = subtotal + item.getSubtotal();
        }
        return subtotal;
    }
 
    public double calcularDescuento() {
        return calcularSubtotal() * porcentajeDescuento / 100.0;
    }
 
    public double calcularEnvio() {
        if (carrito.isEmpty()) {
            return 0.0;
        }
        double montoConDescuento = calcularSubtotal() - calcularDescuento();
        if (montoConDescuento >= ENVIO_GRATIS_DESDE) {
            return 0.0;
        }
        return COSTO_ENVIO;
    }
 
    public double calcularTotal() {
        return calcularSubtotal() - calcularDescuento() + calcularEnvio();
    }
 
 
    public Compra realizarCompra() {
        if (carrito.isEmpty()) {
            return null;
        }
        List<ItemCarrito> itemsComprados = new ArrayList<>(carrito);
        Compra compra = new Compra(siguienteNumeroCompra, itemsComprados, porcentajeDescuento,
                calcularSubtotal(), calcularDescuento(), calcularEnvio(), calcularTotal());
        siguienteNumeroCompra++;
 
        for (ItemCarrito item : itemsComprados) {
            item.getProducto().reducirStock(item.getCantidad());
        }
        historial.add(compra);
 
        carrito.clear();
        porcentajeDescuento = 0;
        return compra;
    }
 
    public List<Compra> getHistorial() {
        return new ArrayList<>(historial);
    }
}

