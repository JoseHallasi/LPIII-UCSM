package Ejercicio3;
 
import java.util.ArrayList;
import java.util.List;
 
public class Jugador {
 
    private String nombre;
    private int salud = 100, saludMaxima = 100, nivel = 1;
    private List<Item> inventario = new ArrayList<>();
    private Item arma;
 
    public Jugador(String nombre) { this.nombre = nombre; }
 
    public String getNombre() { return nombre; }
    public int getSalud() { return salud; }
    public int getSaludMaxima() { return saludMaxima; }
    public int getNivel() { return nivel; }
    public boolean estaVivo() { return salud > 0; }
    public List<Item> getInventario() { return new ArrayList<>(inventario); }
 
    public Item getArma() {
        if (arma != null && !inventario.contains(arma)) arma = null;
        return arma;
    }
 
    public Item buscarItem(String nombre) {
        for (Item i : inventario) {
            if (i.getNombre().equalsIgnoreCase(nombre)) return i;
        }
        return null;
    }
 
    public boolean agregarItem(Item item) {
        if (buscarItem(item.getNombre()) != null) return false;
        return inventario.add(item);
    }
 
    public boolean eliminarItem(Item item) { return inventario.remove(item); }
 
    public int atacar() {
        Item a = getArma();
        return (a == null ? 2 : a.getValor()) + nivel;
    }
 
    public void recibirDanio(int danio) { salud = Math.max(0, salud - danio); }
 
    public boolean usarObjeto(Item item) {
        if (!item.usar()) return false;
        if (item.esPocion()) salud = Math.min(saludMaxima, salud + item.getValor());
        else arma = item;
        return true;
    }
 
    public void subirNivel() {
        nivel++;
        saludMaxima += 10;
        salud = saludMaxima;
    }
 
    public void recuperarSalud() { salud = saludMaxima; }
}


