    }
 
    public void iniciar() {
        String opcion;
        do {
            vista.mostrarMenu();
            opcion = vista.solicitarOpcion();
            switch (opcion) {
                case "1":
                    agregarItem();
                    break;
                case "2":
                    eliminarItem();
                    break;
                case "3":
                    verInventario();
                    break;
                case "4":
                    mostrarDetalles();
                    break;
                case "5":
                    buscarItem();
                    break;
                case "6":
                    usarItem();
                    break;
                case "0":
                    vista.mostrarMensaje("Saliendo...");
                    break;
                default:
                    vista.mostrarMensaje("Opcion no valida. Intentalo de nuevo.");
            }
        } while (!opcion.equals("0"));
        vista.cerrarScanner();
    }
 
    private void agregarItem() {
        String nombre = vista.solicitarTexto("Nombre del item: ");
        int cantidad = vista.solicitarEntero("Cantidad: ");
        int opcionTipo = vista.solicitarTipoItem();
        String descripcion = vista.solicitarTexto("Descripcion: ");
 
        String tipo;
        if (opcionTipo == 1) {
            tipo = Item.TIPO_ARMA;
        } else if (opcionTipo == 2) {
            tipo = Item.TIPO_POCION;
        } else {
            vista.mostrarMensaje("Tipo no valido. No se agrego el item.");
            return;
        }
 
