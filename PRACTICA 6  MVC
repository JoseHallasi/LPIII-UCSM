package Ejercicio3;
 
import java.util.List;
import java.util.Scanner;
 
public class Vista {
 
    private Scanner sc = new Scanner(System.in);
 
    public void msg(String mensaje) { System.out.println(mensaje); }
 
    public String leer(String mensaje) {
        System.out.print(mensaje);
        return sc.nextLine().trim();
    }
 
    public int leerEntero(String mensaje) {
        while (true) {
            try {
                return Integer.parseInt(leer(mensaje));
            } catch (NumberFormatException e) {
                msg("Debes escribir un numero entero valido.");
            }
        }
    }
 
    public String menuPrincipal() {
        msg("\n===== Menu principal =====\n1. Ver inventario\n2. Agregar item\n3. Eliminar item"
                + "\n4. Buscar item por nombre\n5. Ver estado del jugador\n6. Usar / equipar objeto"
                + "\n7. Iniciar combate\n0. Salir");
        return leer("Selecciona una opcion: ");
    }
 
    public String menuCombate() {
        msg("\nQue quieres hacer?\n1. Atacar\n2. Usar objeto\n3. Huir");
        return leer("Selecciona una opcion: ");
    }
 
    public void mostrarInventario(List<Item> items) {
        msg("Inventario:");
        for (int i = 0; i < items.size(); i++) mostrarItem(i + 1 + ". ", items.get(i));
    }
 
    public void mostrarItem(String prefijo, Item it) {
        msg(prefijo + it.getNombre() + " - " + it.getTipo() + " - cantidad: " + it.getCantidad()
                + (it.esArma() ? " - dano: " : " - cura: ") + it.getValor() + " - " + it.getDescripcion());
    }
 
    public void mostrarJugador(Jugador j) {
        Item arma = j.getArma();
        msg("Jugador: " + j.getNombre() + " | Nivel " + j.getNivel() + " | Salud " + j.getSalud() + "/"
                + j.getSaludMaxima() + " | Arma: " + (arma == null ? "ninguna" : arma.getNombre())
                + " | Dano por ataque: " + j.atacar());
    }
 
    public void mostrarCombate(Jugador j, List<Enemigo> enemigos, int ronda) {
        msg("\n=============== RONDA " + ronda + " ===============");
        Item arma = j.getArma();
        msg(j.getNombre() + " (Nivel " + j.getNivel() + ") " + barra(j.getSalud(), j.getSaludMaxima()) + " "
                + j.getSalud() + "/" + j.getSaludMaxima() + " - Arma: " + (arma == null ? "Punos" : arma.getNombre()));
        msg("--------------- Enemigos ---------------");
        for (int i = 0; i < enemigos.size(); i++) {
            Enemigo e = enemigos.get(i);
            if (e.estaVivo()) {
                msg((i + 1) + ". " + e.getNombre() + " [" + e.getTipo() + ", Nivel " + e.getNivel() + "] "
                        + barra(e.getSalud(), e.getSaludMaxima()) + " " + e.getSalud() + "/" + e.getSaludMaxima());
            } else {
                msg((i + 1) + ". " + e.getNombre() + " (derrotado)");
            }
        }
    }
 
    private String barra(int salud, int maxima) {
        int llenos = (int) Math.ceil(salud * 10.0 / maxima);
        return "[" + "#".repeat(llenos) + "-".repeat(10 - llenos) + "]";
    }
}

